# Both values are pre-filled by langctl, which is why the Agent Chat setup
# screen never appears — it only shows when one of them is missing.

# The browser calls this app's own /api passthrough, never the agent directly.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ASSISTANT_ID={{ graph_id }}

# Where the passthrough forwards to. `langctl dev` sets this automatically;
# after deploying, point it at your Agent Server URL.
LANGGRAPH_API_URL=http://127.0.0.1:{{ backend_port }}

# Server-side only. Do NOT prefix with NEXT_PUBLIC_ — that would compile the
# key into the browser bundle.
LANGSMITH_API_KEY=

# Optional. Set to "langsmith-api-key" when using a LangSmith PAT.
# NEXT_PUBLIC_AUTH_SCHEME=

/** The project's name, as it appears in the header and the tab. */
export const APP_NAME = "{{ display_name }}";

/**
 * The app's mark: the project's initials on a colour derived from its name.
 *
 * Deterministic, so the icon never changes between builds. Hue comes from the
 * name; saturation and lightness are fixed here so the mark stays legible on
 * both light and dark backgrounds.
 */
export function LangGraphLogoSVG({
  className,
  width,
  height,
}: {
  width?: number;
  height?: number;
  className?: string;
}) {
  return (
    <svg
      width={width ?? 32}
      height={height ?? 32}
      viewBox="0 0 32 32"
      className={className}
      role="img"
      aria-label="{{ display_name }}"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect
        width="32"
        height="32"
        rx="8"
        fill="hsl({{ brand_hue }} 62% 48%)"
      />
      <text
        x="16"
        y="17"
        textAnchor="middle"
        dominantBaseline="central"
        fontFamily="system-ui, -apple-system, sans-serif"
        fontSize="13"
        fontWeight="640"
        letterSpacing="0.4"
        fill="#FFFFFF"
      >
        {{ initials }}
      </text>
    </svg>
  );
}

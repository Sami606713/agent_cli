# Secrets for `langctl deploy`. Never commit this file.
#
# langctl passes it as `docker compose --env-file .env.deploy`, which makes it
# the source for ${...} substitution in docker-compose.yml. The agent also
# lists it under env_file:, which is how the model key reaches the graph.

# --- model (required) -----------------------------------------------------
MODEL_PROVIDER={{ model_provider }}
MODEL_NAME={{ model_name }}
{% if model_base_url %}
MODEL_BASE_URL={{ model_base_url }}
{% endif %}
{% if model_key_env %}
{{ model_key_env }}=
{% endif %}
{% if licensed %}

# --- infrastructure (required) --------------------------------------------
# Any long random string. Nothing outside the stack reaches this database.
POSTGRES_PASSWORD=change-me

# --- licence (required for the full Agent Server) -------------------------
# This stack runs LangChain's production Agent Server, which validates a
# licence at start-up and will not boot without one. Either a licence key, or
# a LangSmith API key on an account with Agent Server access.
LANGGRAPH_CLOUD_LICENSE_KEY=
LANGSMITH_API_KEY=
{% else %}

# --- LangSmith tracing (entirely optional) --------------------------------
# The agent runs without any of this. Set them only if you want to see traces
# of your runs at smith.langchain.com.
#
#   LANGSMITH_TRACING=true
#   LANGSMITH_API_KEY=lsv2_...
#   LANGSMITH_PROJECT={{ langsmith_project }}
LANGSMITH_TRACING=false
{% endif %}

# Secrets for `langctl deploy`. Never commit this file.
#
# langctl passes it as `docker compose --env-file .env.deploy`, which makes it
# the source for ${...} substitution in docker-compose.yml. The agent service
# also lists it under env_file:, which is how the model key reaches the graph
# inside the container.

# --- infrastructure -------------------------------------------------------
# Any long random string. Nothing outside the stack connects to this database.
POSTGRES_PASSWORD=change-me

# --- LangSmith ------------------------------------------------------------
# Required: the Agent Server validates this at start-up and will not boot
# without it.
LANGSMITH_API_KEY=
{% if langsmith %}
LANGSMITH_PROJECT={{ langsmith_project }}
{% endif %}

# Required for production use of a self-hosted Agent Server. The server does
# start without it, using the API key above — but running it in production that
# way is outside LangChain's licence terms. See DEPLOY.md.
LANGGRAPH_CLOUD_LICENSE_KEY=

# --- model ----------------------------------------------------------------
MODEL_PROVIDER={{ model_provider }}
MODEL_NAME={{ model_name }}
{% if model_base_url %}
MODEL_BASE_URL={{ model_base_url }}
{% endif %}
{% if model_key_env %}
{{ model_key_env }}=
{% endif %}

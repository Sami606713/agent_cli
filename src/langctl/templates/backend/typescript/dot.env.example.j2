# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# `langctl dev` loads .env automatically (langgraph.json points at it).

# ---- Required -------------------------------------------------------------
{% for var, why in required_env.items() %}
# {{ why }}
{% if var == "MODEL_NAME" %}
{% if model_provider == "ollama" %}
# No default: set this to a model you have pulled (`ollama list`).
{% else %}
# No default: set this to whatever {{ model_provider }} serves.
{% endif %}
MODEL_NAME={{ model_name or "" }}
{% else %}
{{ var }}=
{% endif %}
{% endfor %}
{% if model_from_env %}
# MODEL_PROVIDER={{ model_provider }}
{% endif %}

# ---- Memory ---------------------------------------------------------------
{% if long_term_enabled %}
# Long-term memory ({{ long_term_backend }}) is enabled.
{% if long_term_backend == "sqlite" %}
# No JS long-term store backend exists for sqlite yet — this project actually
# runs on an in-memory store. See src/memory/store.ts.
{% endif %}
# Semantic search is not supported for the typescript runtime.
{% else %}
# Long-term memory is disabled.
{% endif %}

# ---- Observability --------------------------------------------------------
{% if langsmith %}
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT={{ langsmith_project }}
{% else %}
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
{% endif %}

# ---- Notes ----------------------------------------------------------------
# Never give a secret a NEXT_PUBLIC_ prefix — that compiles it into the browser
# bundle. The frontend reaches the agent through its server-side proxy route.

"""Configuration, validated at import time.

Failing here — at server start, with a clear message — is much cheaper than
failing on the first user message with a provider auth error.
"""

from __future__ import annotations

import os
from dataclasses import dataclass
from typing import Any


class ConfigError(RuntimeError):
    pass


@dataclass(frozen=True)
class Settings:
    model_provider: str = os.getenv("MODEL_PROVIDER", "{{ model_provider }}")
    model_name: str = os.getenv("MODEL_NAME", "{{ model_name }}")
{% if model_base_url %}
    #: OpenAI-compatible endpoint. Overridable so the same image can point at a
    #: local runtime in development and a gateway in production.
    model_base_url: str = os.getenv("MODEL_BASE_URL", "{{ model_base_url }}")
{% endif %}

    @property
    def model_identifier(self) -> str:
        return f"{self.model_provider}:{self.model_name}"

    @property
    def is_server_managed(self) -> bool:
        """True when running inside a LangGraph Agent Server deployment.

        The server sets this and supplies its own Postgres checkpointer and store;
        `langgraph dev` does not.
        """
        return bool(os.getenv("LANGGRAPH_CLOUD") or os.getenv("LANGGRAPH_API_URL"))

    def validate(self) -> None:
{% if model_key_env %}
        if not os.getenv("{{ model_key_env }}"):
            raise ConfigError(
                "{{ model_key_env }} is not set, but MODEL_PROVIDER="
                f"{self.model_provider}.\n"
                "Add it to .env — see .env.example."
            )
{% else %}
        # {{ model_provider }} needs no API key: it either runs locally or uses
        # ambient credentials, so there is nothing to check here.
        return
{% endif %}


settings = Settings()

# Skipped during tests so the suite runs without provider credentials.
if not os.getenv("{{ name_upper }}_SKIP_CONFIG_VALIDATION"):
    settings.validate()

{% if model_needs_construction %}


def build_model() -> Any:
    """Construct the chat model.

    A plain "provider:model" string cannot carry an endpoint or per-model
    options, so this project builds the model object instead and hands that to
    `create_agent`, which accepts either.
    """
    from langchain.chat_models import init_chat_model

    return init_chat_model(
        settings.model_identifier,
{% if model_base_url %}
        base_url=settings.model_base_url,
{% endif %}
{% for key, value in model_options.items() %}
        {{ key }}={{ value | tojson }},
{% endfor %}
    )
{% endif %}

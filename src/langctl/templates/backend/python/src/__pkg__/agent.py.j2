"""The {{ name }} agent.

`langgraph.json` points at the module-level `graph` in this file. Anything the
Agent Server, Studio, or a deployment needs is reachable from that one symbol.

Imports below are absolute, not relative. The Agent Server loads this file by
path (`./src/{{ pkg }}/agent.py:graph`) rather than importing it as part of a
package, so `from .config import ...` would fail with "attempted relative import
with no known parent package". The package is installed (`dependencies: ["."]`),
so absolute imports resolve.
"""

from __future__ import annotations

from langchain.agents import create_agent

{% if model_needs_construction %}
from {{ pkg }}.config import build_model
{% else %}
from {{ pkg }}.config import settings
{% endif %}
from {{ pkg }}.memory import get_checkpointer
from {{ pkg }}.middleware import MIDDLEWARE
from {{ pkg }}.prompts import SYSTEM_PROMPT
from {{ pkg }}.tools import TOOLS

# Long-term memory is *not* constructed here. The Agent Server opens it from
# `store.path` in langgraph.json and injects it as `runtime.store`, so its
# lifetime matches the server's rather than this module's import.

graph = create_agent(
{% if model_needs_construction %}
    model=build_model(),
{% else %}
    model=settings.model_identifier,
{% endif %}
    tools=TOOLS,
    system_prompt=SYSTEM_PROMPT,
    middleware=MIDDLEWARE,
    checkpointer=get_checkpointer(),
    name="{{ name }}",
)

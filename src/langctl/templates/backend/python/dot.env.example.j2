# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# `langctl dev` loads .env automatically (langgraph.json points at it).

# ---- Model -----------------------------------------------------------------
# Required. The agent refuses to start without this.
{{ model_key_env }}=

# Optional overrides — defaults come from agent.yaml.
# MODEL_PROVIDER={{ model_provider }}
# MODEL_NAME={{ model_name }}

# ---- Observability ---------------------------------------------------------
{% if langsmith %}
# Tracing to LangSmith. Optional for local dev, recommended before you deploy.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT={{ langsmith_project }}
{% else %}
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
{% endif %}

# ---- Notes -----------------------------------------------------------------
# Do NOT put secrets in web/.env.local with a NEXT_PUBLIC_ prefix — anything
# prefixed that way is compiled into the browser bundle. The frontend reaches
# the agent through its server-side proxy route, which reads these values.

# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# `langctl dev` loads .env automatically (langgraph.json points at it).

# ---- Required -------------------------------------------------------------
{% for var, why in required_env.items() %}
# {{ why }}
{{ var }}=
{% endfor %}

# ---- Memory ---------------------------------------------------------------
{% if long_term_enabled %}
# Long-term memory ({{ long_term_backend }}) is enabled.
{% if long_term_backend == "sqlite" %}
# Stored at {{ long_term_path }} — gitignored, contains real conversation data.
# MEMORY_STORE_PATH={{ long_term_path }}
{% endif %}
{% if semantic_search %}
# Semantic search is ON ({{ embedding_mode }} embeddings, {{ embedding_dims }} dims).
{% if embedding_mode == "local" %}
# The model downloads on first use; no API key required.
{% endif %}
{% else %}
# Semantic search is OFF. Memory search uses filters, not vectors.
{% endif %}
{% else %}
# Long-term memory is disabled.
{% endif %}
{% if short_term_backend == "sqlite" %}
# CHECKPOINT_PATH={{ short_term_path }}
{% endif %}

# ---- Observability --------------------------------------------------------
{% if langsmith %}
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT={{ langsmith_project }}
{% else %}
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
{% endif %}

# ---- Notes ----------------------------------------------------------------
# Never give a secret a NEXT_PUBLIC_ prefix — that compiles it into the browser
# bundle. The frontend reaches the agent through its server-side proxy route.

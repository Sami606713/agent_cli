[project]
name = "{{ name }}"
version = "0.1.0"
description = "{{ name }} — a LangChain agent"
# Upper bound is deliberate: the Agent Server supports 3.11-3.13 (the
# `python_version` enum in langgraph.json). Without it, uv would resolve a newer
# local interpreter than the one your deployment runs on.
requires-python = ">=3.11,<3.14"
dependencies = [
{% for package in runtime_packages %}    "{{ package }}",
{% endfor %}]

[project.optional-dependencies]
dev = [
    "langgraph-cli[inmem]>=0.4",
    "pytest>=8.0",
    "pytest-asyncio>=0.24",
    # Supplies the `env` key under [tool.pytest.ini_options] below. Without it
    # pytest ignores that key with a warning, and any test that imports
    # config.py fails on a machine with no provider credentials.
    "pytest-env>=1.1",
    "ruff>=0.6",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ pkg }}"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.pytest.ini_options]
testpaths = ["tests"]
env = ["{{ name_upper }}_SKIP_CONFIG_VALIDATION=1"]

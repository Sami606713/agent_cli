"use client";

import { useStream } from "@langchain/react";
import { useState } from "react";

/**
 * `apiUrl` is a same-origin path, not the agent's address.
 *
 * Requests go to this app's proxy route, which forwards them to whatever
 * `AGENT_PROXY_TARGET` names — the local dev server now, a deployed Agent
 * Server after `agentctl deploy`. This component never changes between the two.
 */
const API_URL = "{{ proxy_prefix }}";
const ASSISTANT_ID = "{{ graph_id }}";

function textOf(content: unknown): string {
  if (typeof content === "string") return content;
  if (Array.isArray(content)) {
    return content
      .map((part) =>
        typeof part === "string"
          ? part
          : part && typeof part === "object" && "text" in part
            ? String((part as { text: unknown }).text)
            : "",
      )
      .join("");
  }
  return "";
}

export default function Chat() {
  const [input, setInput] = useState("");
  const stream = useStream({ apiUrl: API_URL, assistantId: ASSISTANT_ID });

  const send = (event: React.FormEvent) => {
    event.preventDefault();
    const text = input.trim();
    if (!text || stream.isLoading) return;
    setInput("");
    stream.submit({ messages: [{ type: "human", content: text }] });
  };

  return (
    <div className="flex h-dvh flex-col bg-neutral-950 text-neutral-100">
      <header className="flex items-center justify-between border-b border-neutral-800 px-6 py-4">
        <div>
          <h1 className="text-sm font-semibold">{{ name }}</h1>
          <p className="text-xs text-neutral-500">
            {stream.threadId ? `thread ${stream.threadId.slice(0, 8)}` : "new thread"}
          </p>
        </div>
        {stream.isLoading && (
          <button
            onClick={() => stream.stop()}
            className="rounded-md border border-neutral-700 px-3 py-1 text-xs hover:bg-neutral-800"
          >
            Stop
          </button>
        )}
      </header>

      <main className="flex-1 overflow-y-auto px-6 py-6">
        <div className="mx-auto flex max-w-2xl flex-col gap-4">
          {stream.messages.length === 0 && (
            <p className="text-sm text-neutral-500">
              Ask something. Try: <code className="text-neutral-400">what is 42 * 17?</code>
            </p>
          )}

          {stream.messages.map((message, index) => {
            const isHuman = message.getType() === "human";
            const body = textOf(message.content);
            // Tool-call turns have no text content; showing an empty bubble is noise.
            if (!body && !isHuman) return null;
            return (
              <div
                key={message.id ?? index}
                className={isHuman ? "self-end max-w-[85%]" : "self-start max-w-[85%]"}
              >
                <div
                  className={
                    isHuman
                      ? "rounded-2xl bg-blue-600 px-4 py-2 text-sm whitespace-pre-wrap"
                      : "rounded-2xl bg-neutral-900 px-4 py-2 text-sm whitespace-pre-wrap"
                  }
                >
                  {body}
                </div>
              </div>
            );
          })}

          {/* Interrupts pause the run for a human decision. */}
          {stream.interrupt && (
            <div className="rounded-xl border border-amber-700 bg-amber-950/40 p-4 text-sm">
              <p className="mb-3 font-medium text-amber-200">The agent needs your approval</p>
              <pre className="mb-3 overflow-x-auto text-xs text-amber-100/80">
                {JSON.stringify(stream.interrupt.value, null, 2)}
              </pre>
              <div className="flex gap-2">
                <button
                  onClick={() => stream.respond({ approved: true })}
                  className="rounded-md bg-amber-600 px-3 py-1 text-xs font-medium"
                >
                  Approve
                </button>
                <button
                  onClick={() => stream.respond({ approved: false })}
                  className="rounded-md border border-amber-700 px-3 py-1 text-xs"
                >
                  Reject
                </button>
              </div>
            </div>
          )}

          {stream.error != null && (
            <div className="rounded-xl border border-red-800 bg-red-950/40 p-4 text-sm text-red-200">
              {String((stream.error as { message?: string })?.message ?? stream.error)}
            </div>
          )}
        </div>
      </main>

      <form onSubmit={send} className="border-t border-neutral-800 px-6 py-4">
        <div className="mx-auto flex max-w-2xl gap-2">
          <input
            value={input}
            onChange={(event) => setInput(event.target.value)}
            placeholder="Send a message…"
            className="flex-1 rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-2 text-sm outline-none focus:border-neutral-600"
          />
          <button
            type="submit"
            disabled={stream.isLoading || !input.trim()}
            className="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium disabled:opacity-40"
          >
            Send
          </button>
        </div>
      </form>
    </div>
  );
}
